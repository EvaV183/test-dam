---

import Layout from '../layouts/Layout.astro';
import TestContainer from '../components/TestContainer.astro';
import { getEntry } from 'astro:content';

const entrada = await getEntry('tests', 'itinerario-para-la-empleabilidad-2');
const { preguntas, asignatura } = entrada?.data || { preguntas: [], asignatura: ""};
---

<Layout title={asignatura}>
  <TestContainer preguntas={preguntas} asignatura={asignatura} />
</Layout>