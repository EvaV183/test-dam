---
const { asignatura, totalPreguntas } = Astro.props;
---

<div id="quiz-header" class="mb-6">
    <div class="flex justify-between items-end mb-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-100">{asignatura}</h1>
            <p id="contador" class="text-sm text-slate-400">Pregunta 1 de {totalPreguntas}</p>
        </div>
        
        <div class="flex gap-3 text-xs font-bold uppercase tracking-tighter">
            <div class="px-3 py-1 bg-green-900/30 border border-green-500/50 text-green-500 rounded-full">
                ✅ <span id="header-aciertos">0</span>
            </div>
            <div class="px-3 py-1 bg-red-900/30 border border-red-500/50 text-red-500 rounded-full">
                ❌ <span id="header-fallos">0</span>
            </div>
            <div class="px-3 py-1 bg-slate-800 border border-slate-700 text-slate-400 rounded-full">
                ⚪ <span id="header-pendientes">{totalPreguntas}</span>
            </div>
        </div>
    </div>
    
    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
        <div id="progress-bar" class="bg-indigo-500 h-full transition-all duration-300" style="width: 0%"></div>
    </div>
</div>