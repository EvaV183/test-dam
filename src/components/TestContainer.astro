---
const { preguntas: todasLasPreguntas, asignatura } = Astro.props;
const preguntas = todasLasPreguntas.sort(() => Math.random() - 0.5).slice(0, 10);
---

<div class="max-w-2xl mx-auto p-4">
    <div class="hidden border-green-500 border-red-500 bg-green-600 bg-red-600 text-white shadow-green-500/20 shadow-red-500/20 bg-green-900/30 text-green-400"></div>

    <div id="test-header" class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-slate-100">{asignatura}</h1>
        <p id="contador" class="text-sm text-slate-400 mt-2">Pregunta 1 de {preguntas.length}</p>
    </div>

    <div id="quiz-card" class="bg-slate-900 p-6 rounded-3xl shadow-2xl border border-slate-800">
        <h2 id="enunciado" class="text-xl font-medium mb-6 text-slate-100 leading-relaxed"></h2>
        <div id="opciones" class="grid gap-4"></div>
    </div>

    <div id="results-card" class="hidden bg-slate-900 p-8 rounded-3xl shadow-2xl border border-slate-800 text-center">
        <h2 class="text-3xl font-bold mb-2 text-slate-100">¡Test Completado!</h2>
        <p class="text-slate-400 mb-8">Has terminado el repaso de {asignatura}</p>
        
        <div class="flex justify-center gap-12 mb-10">
            <div>
                <p class="text-5xl font-bold text-green-500" id="final-aciertos">0</p>
                <p class="text-xs uppercase tracking-widest text-slate-500 mt-2 font-semibold">Aciertos</p>
            </div>
            <div>
                <p class="text-5xl font-bold text-red-500" id="final-fallos">0</p>
                <p class="text-xs uppercase tracking-widest text-slate-500 mt-2 font-semibold">Fallos</p>
            </div>
        </div>

        <button onclick="window.location.reload()" class="w-full bg-slate-100 text-slate-900 py-4 rounded-2xl font-bold hover:bg-white transition-all transform active:scale-95 shadow-lg shadow-white/5">
            Hacer otro test nuevo
        </button>

        <div class="grid grid-cols-2 gap-4 mt-4">
            <button onclick="resetCurrentTest()" class="py-3 px-4 bg-slate-800 text-slate-200 rounded-xl font-semibold border border-slate-700 hover:bg-slate-700 transition-colors">
                Reiniciar este test
            </button>
            <a href="/" class="py-3 px-4 bg-slate-800 text-slate-200 rounded-xl font-semibold border border-slate-700 hover:bg-slate-700 transition-colors flex items-center justify-center">
                Volver al inicio
            </a>
        </div>
</div>

<script define:vars={{ preguntas, asignatura }}>
    let currentIdx = 0;
    let aciertos = 0;
    let fallos = 0;
    let respondido = false;

    const enunciadoEl = document.getElementById('enunciado');
    const opcionesEl = document.getElementById('opciones');
    const contadorEl = document.getElementById('contador');

    function render() {
        respondido = false;
        const p = preguntas[currentIdx];
        contadorEl.innerText = `Pregunta ${currentIdx + 1} de ${preguntas.length}`;
        enunciadoEl.innerText = p.enunciado;
        opcionesEl.innerHTML = '';

        p.opciones.forEach((op, i) => {
            const btn = document.createElement('button');
            btn.innerText = op;
            // ESTILO BASE OSCURO
            btn.className = "p-5 border border-slate-800 rounded-2xl text-left transition-all duration-200 font-medium bg-slate-800/50 text-slate-200 hover:border-slate-600 active:scale-[0.98]";
            
            btn.onclick = () => {
                if (respondido) return;
                respondido = true;
                handleAnswer(i, p.correcta, btn);
            };
            opcionesEl.appendChild(btn);
        });
    }

    function handleAnswer(selected, correct, btn) {
        const allButtons = opcionesEl.querySelectorAll('button');
        
        if (selected === correct) {
            aciertos++;
            // ACIERTO: Verde sólido pero elegante
            btn.className = "p-5 border border-green-500 rounded-2xl text-left font-bold bg-green-600 text-white shadow-lg shadow-green-500/20 scale-[1.02]";
        } else {
            fallos++;
            // ERROR: Rojo sólido
            btn.className = "p-5 border border-red-500 rounded-2xl text-left font-bold bg-red-600 text-white shadow-lg shadow-red-500/20";
            // La correcta se marca con un borde verde y fondo sutil
            allButtons[correct].className = "p-5 border-2 border-green-500 rounded-2xl text-left font-bold bg-green-900/30 text-green-400";
        }

        setTimeout(() => {
            if (currentIdx < preguntas.length - 1) {
                currentIdx++;
                render();
            } else {
                showResults();
            }
        }, 1500);
    }

    function showResults() {
        document.getElementById('quiz-card').classList.add('hidden');
        document.getElementById('test-header').classList.add('hidden');
        document.getElementById('results-card').classList.remove('hidden');
        document.getElementById('final-aciertos').innerText = aciertos;
        document.getElementById('final-fallos').innerText = fallos;
    }

    render();
</script>